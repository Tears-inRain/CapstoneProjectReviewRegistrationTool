    {
      "name": "6. Get Schedule by Round (Happy Case)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "var schema = {",
              "  \"type\": \"array\",",
              "  \"items\": {",
              "    \"type\": \"object\",",
              "    \"required\": [\"slotId\", \"room\", \"startTime\", \"endTime\", \"reviewers\", \"topics\"],",
              "    \"properties\": {",
              "      \"slotId\": { \"type\": \"integer\" },",
              "      \"room\": { \"type\": \"string\" },",
              "      \"startTime\": { \"type\": \"string\" },",
              "      \"endTime\": { \"type\": \"string\" },",
              "      \"reviewers\": {",
              "        \"type\": \"array\",",
              "        \"minItems\": 2,",
              "        \"maxItems\": 2,",
              "        \"items\": {",
              "          \"type\": \"object\",",
              "          \"required\": [\"lecturerId\", \"fullName\", \"email\"],",
              "          \"properties\": {",
              "            \"lecturerId\": { \"type\": \"integer\" },",
              "            \"fullName\": { \"type\": \"string\" },",
              "            \"email\": { \"type\": \"string\" }",
              "          }",
              "        }",
              "      },",
              "      \"topics\": {",
              "        \"type\": \"array\",",
              "        \"maxItems\": 3,",
              "        \"items\": {",
              "          \"type\": \"object\",",
              "          \"required\": [\"topicId\", \"title\", \"teamId\", \"teamName\", \"instructorId\", \"instructorName\"],",
              "          \"properties\": {",
              "            \"topicId\": { \"type\": \"integer\" },",
              "            \"title\": { \"type\": \"string\" },",
              "            \"teamId\": { \"type\": \"integer\" },",
              "            \"teamName\": { \"type\": \"string\" },",
              "            \"instructorId\": { \"type\": \"integer\" },",
              "            \"instructorName\": { \"type\": \"string\" }",
              "          }",
              "        }",
              "      }",
              "    }",
              "  }",
              "};",
              "pm.test('Response match JSON Schema (Structure & Boundaries)', function () { pm.response.to.have.jsonSchema(schema); });",
              "pm.test('Mỗi slot có tối đa 3 đề tài', function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.forEach(slot => {",
              "        if (slot.topics) pm.expect(slot.topics.length).to.be.at.most(3);",
              "    });",
              "});",
              "pm.test('Mỗi slot phải có đúng 2 GV Review', function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.forEach(slot => {",
              "        if (slot.reviewers) pm.expect(slot.reviewers.length).to.eql(2);",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/Schedule/1"
      }
    }
