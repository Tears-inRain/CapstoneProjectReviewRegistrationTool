{
  "info": {
    "name": "Capstone Project Review Registration Tool v2",
    "description": "TDD Lab & Automation Test Collection Phase 2.6 - Full Cases, Strict Schemas & Assertions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.sendRequest({",
          "    url: pm.environment.get('baseUrl') + '/api/test-setup/reset-db',",
          "    method: 'POST'",
          "}, function (err, res) {",
          "    if (!err) {",
          "        console.log('DB Reset OK', res.json());",
          "    }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Available Slots (Happy Case)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "",
              "var schema = {",
              "  \"type\": \"array\",",
              "  \"items\": {",
              "    \"type\": \"object\",",
              "    \"required\": [\"slotId\", \"startTime\", \"endTime\", \"room\"],",
              "    \"properties\": {",
              "      \"slotId\": { \"type\": \"integer\" },",
              "      \"startTime\": { \"type\": \"string\" },",
              "      \"endTime\": { \"type\": \"string\" },",
              "      \"room\": { \"type\": \"string\" }",
              "    },",
              "    \"additionalProperties\": false",
              "  }",
              "};",
              "",
              "pm.test('Response match JSON Schema', function () { pm.response.to.have.jsonSchema(schema); });",
              "pm.test('Mỗi slot không được vượt quá 3 topics hoặc 2 reviewers', function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.forEach(slot => {",
              "        if(slot.topics) pm.expect(slot.topics.length).to.be.at.most(3);",
              "        if(slot.reviewers) pm.expect(slot.reviewers.length).to.be.at.most(2);",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/Slot/available"
      }
    },
